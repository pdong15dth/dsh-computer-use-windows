{
  "name": "dsh-computer-use-windows",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Computer use for DeepSeek Harness through agent-desktop: accessibility-tree snapshots with refs, semantic clicks, typing, screenshots, windows, clipboard and app control.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pdong15dth/dsh-computer-use-windows.git"
  },
  "keywords": [
    "dsh-plugin",
    "computer-use",
    "agent-desktop",
    "accessibility-tree",
    "ui-automation",
    "windows",
    "macos",
    "linux"
  ],
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "market/index.json",
    "market/icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
