{
  "name": "dsh-computer-use-windows",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Real Windows desktop control for DeepSeek Harness: mouse, keyboard, screen capture, windows, clipboard and app launch through Win32 SendInput/GDI/EnumWindows.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pdong15dth/dsh-computer-use-windows.git"
  },
  "keywords": [
    "dsh-plugin",
    "computer-use",
    "windows",
    "win32",
    "sendinput"
  ],
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "helper/ComputerHelper.cs",
    "helper/serve.ps1",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "PROTOCOL.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
